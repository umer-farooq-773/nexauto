# Wialon GPS Tracking Integration
WIALON_TOKEN=your_wialon_token_here
WIALON_HOST=https://hst-api.wialon.eu
WIALON_CREATOR_ID=your_creator_id_here
WIALON_TEST_MODE=false

# Defaults for new vehicles' Wialon trip and speeding settings
TRIP_DEFAULT_MOVEMENT_TYPE=1
TRIP_DEFAULT_GPS_CORRECTION=true
TRIP_DEFAULT_MIN_SATELLITES=2
TRIP_DEFAULT_MIN_MOVING_SPEED_KMH=1
TRIP_DEFAULT_MIN_PARKING_SECONDS=300
TRIP_DEFAULT_MAX_MESSAGES_DISTANCE_M=10000
TRIP_DEFAULT_MIN_TRIP_SECONDS=60
TRIP_DEFAULT_MIN_TRIP_DISTANCE_M=100
TRIP_DEFAULT_SPEED_LIMIT_KMH=80
TRIP_DEFAULT_SPEEDING_TOLERANCE_KMH=
TRIP_DEFAULT_SPEEDING_MIN_DURATION_S=
TRIP_DEFAULT_SPEEDING_MODE=0

# Driver module defaults for later use
TRIP_WARNING_PERCENT=80
TRIP_SWITCH_MODE=next_stop
TRIP_OFFLINE_MINUTES=5
TRIP_TICK_SECONDS=10

# Set WIALON_TEST_MODE=true to bypass Wialon API calls during testing
# This allows you to test vehicle creation without real GPS devices
# Set to false for production use
